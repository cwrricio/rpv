# Backend FastAPI — SSQM: imagem portável, independente de Firebase Hosting/Functions.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Dependências do sistema mínimas (psycopg precisa de libpq em runtime; o wheel
# psycopg[binary] já traz, mas mantemos build-essential fora para imagem enxuta).
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Código da aplicação
COPY functions ./functions
COPY config ./config
COPY conftest.py pytest.ini ./

EXPOSE 8000

# STORAGE_BACKEND e DATABASE_URL chegam por variável de ambiente (docker-compose).
CMD ["uvicorn", "functions.main:app", "--host", "0.0.0.0", "--port", "8000"]
