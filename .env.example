# Variáveis de ambiente do backend (FastAPI).
# Copie para .env e ajuste os valores. NÃO comite o .env preenchido.

# ─────────────────────────────────────────────────────────────
# BACKEND DE ARMAZENAMENTO
# "postgres" → sem dependência Google em runtime (recomendado).
# "firebase"  → legado, requer PROJECT_ID + RTDB_URL + credencial Google.
# ─────────────────────────────────────────────────────────────
STORAGE_BACKEND=postgres

# Obrigatória quando STORAGE_BACKEND=postgres.
DATABASE_URL=postgresql+psycopg://poshboard:poshboard@localhost:5432/poshboard

# ─────────────────────────────────────────────────────────────
# FIREBASE (necessário APENAS com STORAGE_BACKEND=firebase)
# Com postgres estas variáveis são ignoradas e podem ser omitidas.
# ─────────────────────────────────────────────────────────────
# PROJECT_ID=poshbard
# RTDB_URL=https://poshbard-default-rtdb.firebaseio.com
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ─────────────────────────────────────────────────────────────
# OPCIONAIS
# ─────────────────────────────────────────────────────────────
API_PORT=8000
OPENALEX_MAILTO=seu-email@exemplo.com

# CORS — origens permitidas separadas por vírgula.
# Se vazio/ausente, o backend libera apenas localhost de desenvolvimento.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite) — base da API consumida pelas telas. Build arg no Docker.
# VITE_API_URL=http://127.0.0.1:8000   (no docker-compose é "/api")
